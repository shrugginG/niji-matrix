# Publish only the matrix and the official web application.
/*
!/.gitignore
!/.github/
!/README.md
!/niji-matrix/
!/niji-matrix-web/
**/node_modules/
**/dist/
**/dist-pages/
**/public/data/
**/__pycache__/
**/*.pyc
**/.playwright/
**/test-results/
**/*.log
**/*.orig
**/*.bak
**/.DS_Store
**/.env
**/.env.*
# Raw browser captures can contain session-specific page metadata.
**/*.original.html
