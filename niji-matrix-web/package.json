{
  "name": "niji-matrix-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18091 --strictPort",
    "data": "python3 scripts/export.py",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 18091 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
