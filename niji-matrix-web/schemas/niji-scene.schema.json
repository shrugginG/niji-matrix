{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "category",
    "author",
    "createdAt",
    "updatedAt",
    "matrix",
    "nodes",
    "edges",
    "bindings",
    "viewport",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "category": {
      "enum": [
        "custom",
        "threat",
        "case"
      ]
    },
    "author": {
      "type": "string",
      "maxLength": 300
    },
    "createdAt": {
      "type": "string",
      "maxLength": 300
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 300
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "revision"
      ],
      "properties": {
        "id": {
          "const": "niji-matrix"
        },
        "version": {
          "type": "string",
          "maxLength": 300
        },
        "revision": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "category",
          "name",
          "position",
          "size",
          "color",
          "notes",
          "container"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "attacker",
              "victim",
              "school",
              "hospital",
              "government",
              "securityCompany",
              "cloudProvider",
              "socialPlatform",
              "codeHosting",
              "objectStorage",
              "pc",
              "server",
              "relay",
              "iot",
              "phone",
              "firewall",
              "router",
              "group",
              "organization",
              "department",
              "company",
              "identity",
              "userTerminal",
              "telecom",
              "rentalService",
              "privacyService",
              "domain",
              "certificate",
              "ipAddress",
              "hostedPlatform",
              "gateway",
              "switch",
              "mailServer",
              "authServer",
              "opsServer",
              "backupServer",
              "softwareTool",
              "mailPayload",
              "dataAsset",
              "deliveryMethod",
              "networkZone",
              "annotation",
              "junction"
            ]
          },
          "category": {
            "enum": [
              "human",
              "cloud",
              "endpoint",
              "auxiliary"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number",
                "minimum": 40,
                "maximum": 4000
              },
              "height": {
                "type": "number",
                "minimum": 40,
                "maximum": 4000
              }
            }
          },
          "parentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          },
          "container": {
            "type": "boolean"
          },
          "subtitle": {
            "type": "string",
            "maxLength": 1000
          },
          "entityClass": {
            "enum": [
              "software",
              "artifact",
              "service",
              "annotation"
            ]
          },
          "attributes": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "borderColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "provenance": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceRef",
                "locator",
                "basis"
              ],
              "properties": {
                "sourceRef": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 160
                },
                "locator": {
                  "type": "string",
                  "maxLength": 1000
                },
                "basis": {
                  "enum": [
                    "reported",
                    "analysis",
                    "layout"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "sourcePort",
          "targetPort",
          "name",
          "relation",
          "direction",
          "lineStyle",
          "routing",
          "color",
          "notes",
          "waypoints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "sourcePort": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "targetPort": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "relation": {
            "enum": [
              "social",
              "control",
              "internet",
              "ethernet",
              "delivery",
              "ownership",
              "custom",
              "affiliation",
              "support",
              "procurement",
              "registration",
              "build",
              "intrusion",
              "deployment",
              "hijack",
              "redirection",
              "payload",
              "lateral",
              "collection",
              "exfiltration",
              "concealment",
              "cleanup",
              "persistence",
              "capability"
            ]
          },
          "direction": {
            "enum": [
              "forward",
              "both",
              "none"
            ]
          },
          "lineStyle": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "routing": {
            "enum": [
              "bezier",
              "step",
              "straight"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          },
          "waypoints": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              }
            }
          },
          "anchorMode": {
            "enum": [
              "auto",
              "manual"
            ]
          },
          "provenance": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceRef",
                "locator",
                "basis"
              ],
              "properties": {
                "sourceRef": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 160
                },
                "locator": {
                  "type": "string",
                  "maxLength": 1000
                },
                "basis": {
                  "enum": [
                    "reported",
                    "analysis",
                    "layout"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            }
          },
          "pathGroup": {
            "type": "string",
            "maxLength": 1000
          },
          "labelPosition": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "matrixRef",
          "applicationNote",
          "basis",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "node",
                  "edge"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 160
              }
            }
          },
          "matrixRef": {
            "type": "string",
            "pattern": "^(NJT-[0-9]{4}|NJS-[0-9]{4}-[0-9]{3})$"
          },
          "applicationNote": {
            "type": "string",
            "maxLength": 20000
          },
          "basis": {
            "enum": [
              "fact",
              "inference",
              "hypothesis"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 160
            }
          }
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "zoom": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "maxLength": 2000
          },
          "matrixRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "assetPath": {
            "type": "string",
            "pattern": "^/case-assets/[a-z0-9/-]+\\.(png|txt)$",
            "maxLength": 300
          },
          "author": {
            "type": "string",
            "maxLength": 1000
          },
          "publishedAt": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "presetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 160
    },
    "views": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "nodeIds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "maxLength": 1000
          },
          "nodeIds": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 160
            }
          }
        }
      }
    },
    "legend": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "color",
          "lineStyle"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 1000
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "lineStyle": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          }
        }
      }
    },
    "reviewNotes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Niji Scene 1.0"
}