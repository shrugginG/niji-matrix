{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niji tactic development plan",
  "type": "object",
  "required": ["schema_version", "type", "id", "tactic_ref", "attack_baseline", "status", "candidate_inventory", "batches", "work_items", "gap_analysis", "review"],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "tactic-development-plan"},
    "id": {"type": "string", "pattern": "^PLAN-TA[0-9]{4}$"},
    "tactic_ref": {"type": "string", "pattern": "^TA[0-9]{4}$"},
    "attack_baseline": {
      "type": "object",
      "required": ["domain", "version"],
      "properties": {"domain": {"type": "string"}, "version": {"type": "string"}},
      "additionalProperties": false
    },
    "status": {"enum": ["planned", "active", "review", "complete", "paused"]},
    "candidate_inventory": {
      "type": "object",
      "required": ["status", "source", "last_synced"],
      "properties": {
        "status": {"enum": ["partial", "complete"]},
        "source": {"type": "string", "minLength": 1},
        "last_synced": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "work_item_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^BATCH-TA[0-9]{4}-[0-9]{3}$"},
          "status": {"enum": ["planned", "active", "review", "complete", "paused"]},
          "work_item_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^WORK-TA[0-9]{4}-[A-Z0-9-]+$"}}
        },
        "additionalProperties": false
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_type", "source_attack_id", "name_zh", "name_en", "decision_ref", "resulting_technique_ref", "stage", "batch_ref", "notes_zh", "notes_en"],
        "properties": {
          "id": {"type": "string", "pattern": "^WORK-TA[0-9]{4}-[A-Z0-9-]+$"},
          "source_type": {"enum": ["attack", "niji-proposed"]},
          "source_attack_id": {"type": ["string", "null"], "pattern": "^T[0-9]{4}$"},
          "name_zh": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "decision_ref": {"type": ["string", "null"], "pattern": "^DEC-[A-Z0-9-]+$"},
          "resulting_technique_ref": {"type": ["string", "null"], "pattern": "^NJT-[0-9]{4}$"},
          "stage": {"enum": ["untriaged", "researching", "decision-ready", "excluded", "authoring", "review", "published"]},
          "batch_ref": {"type": ["string", "null"], "pattern": "^BATCH-TA[0-9]{4}-[0-9]{3}$"},
          "notes_zh": {"type": "string"},
          "notes_en": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "gap_analysis": {
      "type": "object",
      "required": ["status", "notes_zh", "notes_en"],
      "properties": {
        "status": {"enum": ["pending", "in-progress", "complete"]},
        "notes_zh": {"type": "string"},
        "notes_en": {"type": "string"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["taxonomy", "evidence", "bilingual", "reviewers"],
      "properties": {
        "taxonomy": {"enum": ["pending", "in-progress", "passed"]},
        "evidence": {"enum": ["pending", "in-progress", "passed"]},
        "bilingual": {"enum": ["pending", "in-progress", "passed"]},
        "reviewers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
