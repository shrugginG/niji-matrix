{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niji detection analytic",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "strategy_ref",
    "name",
    "summary",
    "domains",
    "platforms",
    "logic",
    "data_requirements",
    "observables",
    "correlation",
    "false_positives",
    "blind_spots",
    "tuning_guidance",
    "evidence_refs",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "type": {
      "const": "detection-analytic"
    },
    "id": {
      "type": "string",
      "pattern": "^NJA-[0-9]{6}$"
    },
    "strategy_ref": {
      "type": "string",
      "pattern": "^DET-[0-9]{6}$"
    },
    "name": {
      "$ref": "#/$defs/localizedLabel"
    },
    "summary": {
      "$ref": "#/$defs/localizedText"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "enterprise",
          "mobile",
          "ics"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "logic": {
      "$ref": "#/$defs/narrativeSection"
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "name",
          "channel",
          "required_fields"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "$ref": "#/$defs/localizedLabel"
          },
          "channel": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+$"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/localizedLabel"
      }
    },
    "correlation": {
      "type": "object",
      "required": [
        "window",
        "dimensions"
      ],
      "properties": {
        "window": {
          "$ref": "#/$defs/localizedText"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "false_positives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localizedLabel"
      },
      "minItems": 1
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localizedLabel"
      },
      "minItems": 1
    },
    "tuning_guidance": {
      "$ref": "#/$defs/narrativeSection"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF-[0-9]{6}$"
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    }
  },
  "$defs": {
    "localizedLabel": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "localizedText": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 10
        },
        "en": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "narrativeSection": {
      "type": "object",
      "required": [
        "paragraphs"
      ],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/localizedText"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "version",
        "created",
        "modified",
        "contributors",
        "reviewers"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "review",
            "accepted",
            "published",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "modified": {
          "type": "string",
          "format": "date"
        },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "published"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reviewers": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
