{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Procedure case",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "name_zh",
    "name_en",
    "subject_refs",
    "description_zh",
    "description_en",
    "time_range",
    "target_sectors_zh",
    "target_sectors_en",
    "evidence_refs",
    "confidence",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "case"},
    "id": {"type": "string", "pattern": "^CASE-[0-9]{6}$"},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "actor_or_campaign": {"type": ["string", "null"]},
    "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "description_zh": {"type": "string", "minLength": 1},
    "description_en": {"type": "string", "minLength": 1},
    "time_range": {"type": ["string", "null"]},
    "target_sectors_zh": {"type": "array", "items": {"type": "string"}},
    "target_sectors_en": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^REF-[0-9]{6}$"}
    },
    "confidence": {"enum": ["hypothesis", "low", "medium", "high"]},
    "status": {"enum": ["draft", "review", "accepted", "rejected"]}
  },
  "additionalProperties": false
}
