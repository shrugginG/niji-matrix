{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research claim",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "claim_type",
    "statement_zh",
    "statement_en",
    "subject_refs",
    "evidence_refs",
    "evidence_mode",
    "confidence",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "claim"},
    "id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
    "claim_type": {
      "enum": [
        "technique-relevance",
        "technique-boundary",
        "mechanism-mapping",
        "subtechnique-existence",
        "case-attribution",
        "detection",
        "mitigation",
        "other"
      ]
    },
    "statement_zh": {"type": "string", "minLength": 1},
    "statement_en": {"type": "string", "minLength": 1},
    "subject_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^REF-[0-9]{6}$"}
    },
    "evidence_mode": {
      "enum": ["directly-observed", "strongly-inferred", "hypothesized"]
    },
    "confidence": {"enum": ["hypothesis", "low", "medium", "high"]},
    "status": {"enum": ["draft", "review", "accepted", "rejected"]}
  },
  "additionalProperties": false
}
