{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niji detection strategy",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "name",
    "summary",
    "description",
    "detects_refs",
    "domains",
    "analytic_refs",
    "evidence_refs",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "type": {
      "const": "detection-strategy"
    },
    "id": {
      "type": "string",
      "pattern": "^DET-[0-9]{6}$"
    },
    "name": {
      "$ref": "#/$defs/localizedLabel"
    },
    "summary": {
      "$ref": "#/$defs/localizedText"
    },
    "description": {
      "$ref": "#/$defs/narrativeSection"
    },
    "detects_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:NJT-[0-9]{4}|NJS-[0-9]{4}-[0-9]{3})$"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "enterprise",
          "mobile",
          "ics"
        ]
      }
    },
    "analytic_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^NJA-[0-9]{6}$"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REF-[0-9]{6}$"
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    }
  },
  "$defs": {
    "localizedLabel": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "localizedText": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 10
        },
        "en": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "narrativeSection": {
      "type": "object",
      "required": [
        "paragraphs"
      ],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/localizedText"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "version",
        "created",
        "modified",
        "contributors",
        "reviewers"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "review",
            "accepted",
            "published",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "modified": {
          "type": "string",
          "format": "date"
        },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "published"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reviewers": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
