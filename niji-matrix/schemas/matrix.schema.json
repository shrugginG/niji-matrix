{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niji Matrix manifest",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "name_zh",
    "name_en",
    "description_zh",
    "description_en",
    "attack_baseline",
    "layers",
    "mechanism_refs",
    "tactic_refs",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "matrix"},
    "id": {"const": "niji-matrix"},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "description_zh": {"type": "string", "minLength": 1},
    "description_en": {"type": "string", "minLength": 1},
    "attack_baseline": {
      "type": "object",
      "required": [
        "framework",
        "domain",
        "version",
        "tactic_policy",
        "technique_policy",
        "original_subtechnique_policy"
      ],
      "properties": {
        "framework": {"const": "MITRE ATT&CK"},
        "domain": {"const": "enterprise-attack"},
        "version": {"type": "string"},
        "tactic_policy": {"const": "inherited"},
        "technique_policy": {"const": "screened_and_extended"},
        "original_subtechnique_policy": {"const": "not_imported"}
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["level", "type", "policy"],
        "properties": {
          "level": {"type": "integer", "minimum": 1, "maximum": 3},
          "type": {
            "enum": ["tactic", "technique", "evasion-subtechnique"]
          },
          "policy": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "mechanism_refs": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^NM-[A-Z]{2}$"}
    },
    "tactic_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TA[0-9]{4}$"}
    },
    "lifecycle": {"$ref": "#/$defs/lifecycle"}
  },
  "$defs": {
    "lifecycle": {
      "type": "object",
      "required": ["status", "version", "created", "modified"],
      "properties": {
        "status": {"enum": ["draft", "review", "published", "deprecated"]},
        "version": {"type": "string"},
        "created": {"type": "string"},
        "modified": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
