{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stealth mechanism",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "name_en",
    "name_zh",
    "shortname",
    "core_question_zh",
    "core_question_en",
    "definition_zh",
    "definition_en",
    "defender_effect_zh",
    "defender_effect_en",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "mechanism"},
    "id": {"type": "string", "pattern": "^NM-[A-Z]{2}$"},
    "name_en": {"type": "string", "minLength": 1},
    "name_zh": {"type": "string", "minLength": 1},
    "shortname": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "core_question_zh": {"type": "string", "minLength": 1},
    "core_question_en": {"type": "string", "minLength": 1},
    "definition_zh": {"type": "string", "minLength": 1},
    "definition_en": {"type": "string", "minLength": 1},
    "defender_effect_zh": {"type": "string", "minLength": 1},
    "defender_effect_en": {"type": "string", "minLength": 1},
    "lifecycle": {
      "type": "object",
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["draft", "published", "deprecated"]},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
