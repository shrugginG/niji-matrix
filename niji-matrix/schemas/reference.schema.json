{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference source",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "title_zh",
    "title_en",
    "source_type",
    "authors",
    "publisher",
    "published",
    "url",
    "accessed",
    "locator",
    "credibility",
    "notes_zh",
    "notes_en"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "reference"},
    "id": {"type": "string", "pattern": "^REF-[0-9]{6}$"},
    "title_zh": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "source_type": {
      "enum": [
        "official-documentation",
        "academic-paper",
        "incident-report",
        "threat-report",
        "vendor-report",
        "news",
        "dataset",
        "sample-analysis",
        "web-page",
        "other"
      ]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "doi": {"type": ["string", "null"]},
        "rfc": {"type": ["string", "null"]},
        "arxiv": {"type": ["string", "null"]},
        "attack_id": {"type": ["string", "null"]},
        "other": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "authors": {"type": "array", "items": {"type": "string"}},
    "publisher": {"type": ["string", "null"]},
    "published": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"], "format": "uri"},
    "accessed": {"type": ["string", "null"]},
    "locator": {"type": ["string", "null"]},
    "archive_url": {"type": ["string", "null"], "format": "uri"},
    "credibility": {"enum": ["low", "medium", "high"]},
    "notes_zh": {"type": "string"},
    "notes_en": {"type": "string"}
  },
  "additionalProperties": false
}
