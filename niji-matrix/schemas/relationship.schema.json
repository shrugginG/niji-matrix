{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-object relationship",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "relationship_type",
    "source_ref",
    "target_ref",
    "description_zh",
    "description_en",
    "evidence_refs",
    "confidence",
    "status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "relationship"},
    "id": {"type": "string", "pattern": "^REL-[0-9]{6}$"},
    "relationship_type": {
      "enum": [
        "subtechnique-of",
        "uses",
        "detects",
        "mitigates",
        "supports",
        "replaces",
        "related-to"
      ]
    },
    "source_ref": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "description_zh": {"type": "string"},
    "description_en": {"type": "string"},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^REF-[0-9]{6}$"}
    },
    "confidence": {"enum": ["hypothesis", "low", "medium", "high"]},
    "status": {"enum": ["draft", "review", "accepted", "deprecated"]}
  },
  "additionalProperties": false
}
