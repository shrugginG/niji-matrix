{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niji evasion sub-technique — shared section model",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "name",
    "summary",
    "aliases",
    "definition_and_concept",
    "stealth_characteristics",
    "scope_boundary_definition",
    "application_scenarios_and_threat_model",
    "stealth_mechanisms",
    "defense",
    "evidence",
    "research",
    "lifecycle",
    "parent_ref",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^NJS-[0-9]{4}-[0-9]{3}$"
    },
    "name": {
      "$ref": "#/$defs/localizedLabel"
    },
    "summary": {
      "$ref": "#/$defs/localizedText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition_and_concept": {
      "$ref": "#/$defs/narrativeSection"
    },
    "stealth_characteristics": {
      "$ref": "#/$defs/narrativeSection"
    },
    "scope_boundary_definition": {
      "$ref": "#/$defs/narrativeSection"
    },
    "application_scenarios_and_threat_model": {
      "$ref": "#/$defs/applicationThreatModel"
    },
    "stealth_mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stealthMechanism"
      }
    },
    "defense": {
      "type": "object",
      "required": [
        "detections",
        "mitigations"
      ],
      "properties": {
        "detections": {
          "$ref": "#/$defs/detectionCoverage"
        },
        "mitigations": {
          "$ref": "#/$defs/mitigationCoverage"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "research": {
      "type": "object",
      "required": [
        "limitations"
      ],
      "properties": {
        "limitations": {
          "$ref": "#/$defs/narrativeSection"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "type": {
      "const": "evasion-subtechnique"
    },
    "parent_ref": {
      "type": "string",
      "pattern": "^NJT-[0-9]{4}$"
    },
    "lineage": {
      "type": "object",
      "required": [
        "attck_subtechnique_inherited"
      ],
      "properties": {
        "attck_subtechnique_inherited": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "localizedLabel": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "localizedText": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 10
        },
        "en": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "localizedSummary": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 5,
          "pattern": "[^。！？.!?]$"
        },
        "en": {
          "type": "string",
          "minLength": 10,
          "pattern": "[^。！？.!?]$"
        }
      },
      "additionalProperties": false
    },
    "narrativeSection": {
      "type": "object",
      "required": [
        "paragraphs"
      ],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/localizedText"
          }
        }
      },
      "additionalProperties": false
    },
    "applicationThreatModel": {
      "type": "object",
      "required": [
        "application_scenarios",
        "threat_model"
      ],
      "properties": {
        "application_scenarios": {
          "$ref": "#/$defs/narrativeSection"
        },
        "threat_model": {
          "type": "object",
          "required": [
            "attacker_model",
            "defender_model"
          ],
          "properties": {
            "attacker_model": {
              "$ref": "#/$defs/narrativeSection"
            },
            "defender_model": {
              "$ref": "#/$defs/narrativeSection"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stealthMechanism": {
      "type": "object",
      "required": [
        "mechanism_ref",
        "role",
        "summary",
        "analysis",
        "evidence_refs",
        "confidence"
      ],
      "properties": {
        "mechanism_ref": {
          "type": "string",
          "pattern": "^NM-[A-Z]{2}$"
        },
        "role": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "summary": {
          "$ref": "#/$defs/localizedSummary"
        },
        "analysis": {
          "$ref": "#/$defs/narrativeSection"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REF-[0-9]{6}$"
          }
        },
        "confidence": {
          "enum": [
            "hypothesis",
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "detectionCoverage": {
      "type": "object",
      "required": [
        "coverage",
        "strategy_refs"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "available",
            "not-applicable",
            "deferred"
          ]
        },
        "strategy_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DET-[0-9]{6}$"
          }
        },
        "rationale": {
          "$ref": "#/$defs/narrativeSection"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "coverage"
            ],
            "properties": {
              "coverage": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "strategy_refs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "rationale"
            ],
            "properties": {
              "strategy_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "mitigationCoverage": {
      "type": "object",
      "required": [
        "coverage",
        "mitigation_refs"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "available",
            "not-applicable",
            "deferred"
          ]
        },
        "mitigation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MIT-[0-9]{6}$"
          }
        },
        "rationale": {
          "$ref": "#/$defs/narrativeSection"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "coverage"
            ],
            "properties": {
              "coverage": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "mitigation_refs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "rationale"
            ],
            "properties": {
              "mitigation_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "claim_refs",
        "case_refs",
        "reference_refs"
      ],
      "properties": {
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CLM-[0-9]{6}$"
          }
        },
        "case_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CASE-[0-9]{6}$"
          }
        },
        "reference_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REF-[0-9]{6}$"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "version",
        "created",
        "modified",
        "contributors",
        "reviewers"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "review",
            "published",
            "deprecated"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "modified": {
          "type": "string",
          "format": "date"
        },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "published"
              }
            }
          },
          "then": {
            "properties": {
              "reviewers": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
