{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Niji tactic with source provenance",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "name_en",
    "name_zh",
    "shortname",
    "source",
    "description_zh",
    "description_en",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "tactic"},
    "id": {"type": "string", "pattern": "^TA[0-9]{4}$"},
    "name_en": {"type": "string", "minLength": 1},
    "name_zh": {"type": "string", "minLength": 1},
    "shortname": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "source": {
      "type": "object",
      "required": ["framework", "domain", "version", "external_id", "url"],
      "properties": {
        "framework": {"const": "MITRE ATT&CK"},
        "domain": {"const": "enterprise-attack"},
        "version": {"type": "string"},
        "external_id": {"type": "string", "pattern": "^TA[0-9]{4}$"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "description_zh": {"type": "string", "minLength": 1},
    "description_en": {"type": "string", "minLength": 1},
    "lifecycle": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"const": "inherited"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
