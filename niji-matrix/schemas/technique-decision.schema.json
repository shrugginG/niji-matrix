{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technique admission decision",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "id",
    "tactic_ref",
    "candidate",
    "decision",
    "rationale_zh",
    "rationale_en",
    "scope_notes_zh",
    "scope_notes_en",
    "original_attack_subtechniques_imported",
    "evidence_refs",
    "confidence",
    "review"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "type": {"const": "technique-decision"},
    "id": {"type": "string", "pattern": "^DEC-[A-Z0-9-]+$"},
    "tactic_ref": {"type": "string", "pattern": "^TA[0-9]{4}$"},
    "candidate": {
      "type": "object",
      "required": ["source_type", "name_en", "name_zh"],
      "properties": {
        "source_type": {"enum": ["attack", "niji-proposed"]},
        "source_attack_id": {"type": ["string", "null"], "pattern": "^T[0-9]{4}$"},
        "source_attack_version": {"type": ["string", "null"]},
        "name_en": {"type": "string", "minLength": 1},
        "name_zh": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision": {"enum": ["retain", "adapt", "exclude", "add"]},
    "rationale_zh": {"type": "string", "minLength": 1},
    "rationale_en": {"type": "string", "minLength": 1},
    "scope_notes_zh": {"type": "string"},
    "scope_notes_en": {"type": "string"},
    "gap_statement_zh": {"type": ["string", "null"]},
    "gap_statement_en": {"type": ["string", "null"]},
    "original_attack_subtechniques_imported": {"const": false},
    "resulting_technique_ref": {
      "type": ["string", "null"],
      "pattern": "^NJT-[0-9]{4}$"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^REF-[0-9]{6}$"}
    },
    "confidence": {"enum": ["hypothesis", "low", "medium", "high"]},
    "review": {
      "type": "object",
      "required": ["status", "authors", "reviewers"],
      "properties": {
        "status": {"enum": ["draft", "review", "approved", "rejected"]},
        "authors": {"type": "array", "items": {"type": "string"}},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "review_notes_zh": {"type": "string"},
        "review_notes_en": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
